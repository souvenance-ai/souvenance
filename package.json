{
  "name": "souvenance",
  "version": "0.2.0",
  "type": "module",
  "description": "AI memory",
  "keywords": [],
  "author": "Valentin Richard",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/souvenance-ai/souvenance.git"
  },
  "packageManager": "yarn@4.18.1",
  "main": "src/cli/cli.ts",
  "scripts": {
    "=== FB: BUILD ===": "",
    "fb:build": "fabrique build",
    "=== FB: TEST ===": "",
    "fb:test": "vitest run",
    "fb:test:coverage": "vitest run --coverage",
    "fb:bench": "vitest bench",
    "=== FB: CODE QUALITY ===": "",
    "fb:format": "yarn fb:format:fix",
    "fb:format:check": "prettier --check --ignore-unknown --config .prettierrc \"./**/*.{js,jsx,ts,tsx,html,css,scss,json,md}\"",
    "fb:format:fix": "prettier --write --ignore-unknown --config .prettierrc \"./**/*.{js,jsx,ts,tsx,html,css,scss,json,md}\"",
    "fb:check": "yarn fb:check:types && yarn fb:format:check",
    "fb:check:types": "tsc -p tsconfig.json --noEmit",
    "=== FB: RELEASE ===": "",
    "fb:manual:release": "fabrique release",
    "fb:ci:release": "fabrique ci release",
    "=== CUSTOM ===": "",
    "run": "node src/cli/cli.ts",
    "link": "npm link"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-istanbul": "^5.0.5",
    "fabrique": "2.0.23",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "access": "public",
  "bin": "src/cli/cli.ts",
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@inquirer/prompts": "^8.7.4",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "fabrique": {
    "version": "2.0.23",
    "type": "lib"
  },
  "engines": {
    "node": ">=24"
  }
}
